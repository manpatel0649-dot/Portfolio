# ── Public config (not secrets, safe to expose) ──────────────────────────────

# Override the default site URL (already set in lib/site.ts).
# Only needed when switching to a custom domain — set this in Vercel env vars.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Secrets (never commit real values) ───────────────────────────────────────

# Resend API key for contact form email sending.
# Get one at https://resend.com — free tier is 3,000 emails/month.
# Without this the form falls back to mailto:.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
